from typing import TypedDict

class RawDetection(TypedDict):
    format: str
    payload_bytes: bytes | None
    text: str | None
    payload_status: str
    byte_segments: list[bytes]
    landmarks: list[tuple[float, float, str]]

class ReedQRError(Exception): ...
class InvalidFrameError(ReedQRError): ...
class UnsupportedFormatError(ReedQRError): ...
class ResourceLimitError(ReedQRError): ...
class ImageDecodeError(ReedQRError): ...
class EncodeError(ReedQRError): ...
class CodecError(ReedQRError): ...

def decode_image(data: bytes, options: tuple[int, int, int, int]) -> list[RawDetection]: ...
def decode_frame(
    data: bytes, layout: tuple[int, int, int, str], options: tuple[int, int, int, int]
) -> list[RawDetection]: ...
def encode_text(
    text: str, pixels_per_module: int, quiet_zone: int, error_correction: str
) -> tuple[int, bytes, bytes]: ...
